NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

ADMIN_EMAIL_ALLOWLIST=ops@example.com
BACKEND_BASE_URL=https://finance-backend.example.com
# Used by server-side analyst, research, and data-ops proxy routes.
BACKEND_SERVICE_TOKEN=
# Optional for local dev against unprotected localhost backends.
# Required in production when finance-backend is behind Cloudflare Access.
CF_ACCESS_CLIENT_ID=
CF_ACCESS_CLIENT_SECRET=
# Backward-compat aliases (deprecated):
FINANCE_BACKEND_URL=
FINANCE_BACKEND_SERVICE_TOKEN=

MODEL_REGISTRY_API_URL=http://localhost:8000
# Registry API auth headers are not yet wired in this repo.
MODEL_REGISTRY_API_TIMEOUT_SECONDS=10
